{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gy-portfolio",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gy-portfolio-db",
      // Paste the id printed by: npx wrangler d1 create gy-portfolio-db
      "database_id": "a924e194-6269-40d2-80ff-b4fafbe4f3af",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
    "PORTFOLIO_EDITOR_EMAIL": "",
    "PUBLIC_SITE_URL": "https://gy-portfolio.guangyou.workers.dev"
  }
}
