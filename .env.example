# Cloudflare Access team domain, without https://. Example: your-team.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag from the Access self-hosted application
CF_ACCESS_AUD=
# Owner email allowed to edit /customize. Compared case-insensitively to the verified Access email.
PORTFOLIO_EDITOR_EMAIL=
# Optional public origin, including https://. Resume uses the request origin when this is empty.
PUBLIC_SITE_URL=
